# オンライン版v0で外出し予定の環境変数例
# 現時点では auto_post_unified.py 側の既存設定も参照します。

SEARCHAPI_API_KEY=
ONLINE_APP_HOST=0.0.0.0
ONLINE_APP_PORT=8000
ONLINE_APP_DATA_DIR=./online_app_data
# runningのまま一定時間更新されないジョブを中断扱いへ戻す目安（分）
ONLINE_APP_STALE_RUNNING_MINUTES=180

# 公開環境では、auto_post_unified.py内の固定キーではなくこちらで上書きしてください。
# 形式: [{"name":"結びのマリッジ用","key":"AIza..."}]
ONLINE_GEMINI_KEYS_NORMAL_JSON=
ONLINE_GEMINI_KEYS_MOECHIN_JSON=

# WordPress認証情報の上書き。サイトキー単位で必要な項目だけ指定できます。
# 例: {"2":{"url":"https://www.marriage-mr.com","user":"...","pass":"..."}}
ONLINE_WP_SITE_OVERRIDES_JSON=

# 今後移す候補
# WP_SITE_MARRIAGE_URL=
# WP_SITE_MARRIAGE_USER=
# WP_SITE_MARRIAGE_APP_PASSWORD=
